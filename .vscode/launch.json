{
	"version": "0.2.0",
	"configurations": [
		{
			"type": "node",
			"request": "launch",
			"name": "Debug NestJS",
			"runtimeExecutable": "npm",
			"runtimeArgs": ["run", "start:debug"],
			"console": "integratedTerminal",
			"restart": true,
			"sourceMaps": true,
			"envFile": "${workspaceFolder}/.env",
			"skipFiles": ["<node_internals>/**"],
			"outFiles": ["${workspaceFolder}/dist/**/*.js"]
		},
		{
			"type": "node",
			"request": "attach",
			"name": "Attach to NestJS",
			"port": 9229,
			"restart": true,
			"sourceMaps": true,
			"outFiles": ["${workspaceFolder}/dist/**/*.js"]
		}
	]
}
