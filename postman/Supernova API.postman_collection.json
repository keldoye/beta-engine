		{
			"name": "Auth",
			"item": [
				{
					"name": "Sign In",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"",
									"// Test si la réponse est un succès",
									"pm.test(\"Connexion réussie\", () => {",
									"    pm.response.to.have.status(201);",
									"    pm.expect(response.access_token).to.exist;",
									"});",
									"",
									"// Sauvegarde automatique du token",
									"if (response.access_token) {",
									"    pm.environment.set(\"jwt_token\", response.access_token);",
									"    console.log(\"Token JWT sauvegardé dans l'environnement\");",
									"}"
								],
								"type": "text/javascript",
								"packages": {},
								"requests": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"primaryEmail\": \"{{default_email}}\",\n    \"password\": \"{{default_password}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/auth",
							"host": ["{{base_url}}"],
							"path": ["auth"]
						},
						"description": "Authenticate user and get JWT token"
					},
					"response": []
				},
